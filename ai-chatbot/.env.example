# ── Server ────────────────────────────────────────────────────────────────
PORT=4500
# Origin of the PeoplePay360 frontend that is allowed to call this service.
ALLOWED_ORIGIN=http://localhost:3000

# ── AI master switch ─────────────────────────────────────────────────────
# When false, ALL AI endpoints respond with a controlled "AI disabled"
# result. The main PeoplePay360 app is never affected either way.
AI_ENABLED=true

# Which provider handles generation first. gemini | ollama
# Switching this requires zero code changes.
AI_PROVIDER=gemini

# ── Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=8000

# ── Ollama (local fallback / alternate provider) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=15000

# ── PeoplePay360 main API (TODO: fill in once real project is connected) ──
# TODO(real-project): confirm actual base URL of the PeoplePay360 backend.
PEOPLEPAY360_API_BASE_URL=http://localhost:5000
PEOPLEPAY360_API_TIMEOUT_MS=5000

# ── Conversation context ────────────────────────────────────────────────
CONTEXT_TTL_MS=1800000
CONFIRMATION_TTL_MS=300000
