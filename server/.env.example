# Copy this file to server/.env before starting the API.

PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/peoplepay360?schema=public&connection_limit=10&pool_timeout=10"

# Signs the session cookie. Must be at least 32 characters — the server
# refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-at-least-32-random-characters"
JWT_EXPIRES_IN_SECONDS=28800

# Origin allowed by CORS. The Vite dev server proxies /api, so in normal
# development requests are same-origin and this is only a fallback.
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# "Sign in with Google" — optional. Leave both unset to disable the feature;
# the login page hides the button automatically and email/password login is
# unaffected either way.
#
# Setup:
#   1. https://console.cloud.google.com/apis/credentials -> Create credentials
#      -> OAuth client ID -> Web application.
#   2. Authorized redirect URI: must exactly match GOOGLE_CALLBACK_URL below
#      (http://localhost:5173/api/auth/google/callback for local dev).
#   3. Authorized JavaScript origin: CLIENT_ORIGIN above.
#   4. Copy the generated client ID and client secret below.
#
# Only an existing, active local account with a matching *verified* Google
# email can sign in this way — Google proves identity, it never creates an
# account or changes anyone's roles.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to `${CLIENT_ORIGIN}/api/auth/google/callback` if unset. Override
# only if the API is reachable at a different origin than the client.
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# Login rate limiting only — three independent keys (IP, account, browser).
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=900
RATE_LIMIT_LOGIN_DEVICE_MAX=8
RATE_LIMIT_LOGIN_DEVICE_WINDOW=60
MAX_BULK_EMAIL_RECIPIENTS=10
# Cooldowns that stop a button being mashed into repeated server work.
ACTION_COOLDOWN_SECONDS=10
EMAIL_COOLDOWN_SECONDS=300
PDF_COOLDOWN_SECONDS=5
# Sitewide backstop on every write (POST/PUT/PATCH/DELETE), by IP and by
# account — HR, attendance, timeoff, users, payroll config, everything else.
WRITE_RATE_LIMIT_IP_MAX=60
WRITE_RATE_LIMIT_IP_WINDOW=60
WRITE_RATE_LIMIT_USER_MAX=30
WRITE_RATE_LIMIT_USER_WINDOW=60

# Shown on payslips, PDFs and the dashboard. Single company by design.
COMPANY_NAME="OXP Pvt Ltd"

# Which calendar day an attendance check-in belongs to is decided in this
# timezone, so the business day does not follow the server's location.
COMPANY_TIMEZONE="Asia/Kolkata"

# Set to true to print every Prisma query — used during the performance audit.
PRISMA_LOG_QUERIES=false

# Authenticated SMTP.
# For Gmail, SMTP_PASSWORD must be a 16-character App Password from
# https://myaccount.google.com/apppasswords (2-Step Verification required) —
# a normal account password is rejected. MAIL_FROM should be the authenticated
# Gmail address or a verified Gmail Send mail as alias.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=vrajpatel621204@gmail.com
#   SMTP_PASSWORD=xxxxxxxxxxxxxxxx
#   MAIL_FROM=vrajpatel621204@gmail.com
#
# SMTP_SECURE is inferred from the port (465 = true, 587 = STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-email@gmail.com
SMTP_SECURE=false
