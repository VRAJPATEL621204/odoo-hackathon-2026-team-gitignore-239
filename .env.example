# Used by docker compose to start PostgreSQL and configure the external SMTP provider.
# Copy this file to .env and replace the SMTP placeholders.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peoplepay360
POSTGRES_PORT=5433

# Do not run the demo-data seed on every startup.
SEED_DATABASE=false

# Required by the application. Generate a value of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY_HOPS=0
# Login rate limiting only — three independent keys (IP, account, browser).
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_LOGIN_ACCOUNT_MAX=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=900
RATE_LIMIT_LOGIN_DEVICE_MAX=8
RATE_LIMIT_LOGIN_DEVICE_WINDOW=60
MAX_BULK_EMAIL_RECIPIENTS=10
# Cooldowns that stop a button being mashed into repeated server work.
ACTION_COOLDOWN_SECONDS=10
EMAIL_COOLDOWN_SECONDS=300
PDF_COOLDOWN_SECONDS=5

# Authenticated SMTP provider. Gmail example: smtp.gmail.com, port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vrajpatel621204@gmail.com
SMTP_PASSWORD=replace-with-your-gmail-app-password
SMTP_SECURE=false
MAIL_FROM=vrajpatel621204@gmail.com

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/peoplepay360?schema=public"
