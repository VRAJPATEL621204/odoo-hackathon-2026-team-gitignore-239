# Used by docker compose to start PostgreSQL and Mailpit.
# Copy this file to .env — the values below work as-is for local development.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peoplepay360
POSTGRES_PORT=5433

# Mailpit: 1025 is the SMTP port the API sends to, 8025 is the web inbox.
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/peoplepay360?schema=public"
